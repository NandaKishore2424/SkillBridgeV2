<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.8</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.skillbridge</groupId>
	<artifactId>skillbridge-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>skillbridge-backend</name>
	<description>Backend service for SkillBridge (multi-tenant training management platform)</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>17</java.version>
		<jjwt.version>0.12.6</jjwt.version>
	</properties>
	<dependencies>
		<!--
			JJWT. The version is declared once here and inherited by all three
			artifacts: api is compile-scope, impl and jackson are runtime-only so
			that application code cannot accidentally bind to internals.
		-->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.bucket4j</groupId>
			<artifactId>bucket4j_jdk17-core</artifactId>
			<version>8.17.0</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Scrape target for the Hikari pool gauges. The actuator exposure list
		     names `prometheus`; without this registry that endpoint 404s, so the
		     config would advertise an endpoint that does not exist. -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<!-- Structured logging. JSON off the local profile, so a log aggregator
		     can query fields instead of parsing a line format. -->
		<dependency>
			<groupId>net.logstash.logback</groupId>
			<artifactId>logstash-logback-encoder</artifactId>
			<version>8.0</version>
		</dependency>
		<!-- L1 cache. Caffeine rather than the starter's default simple
		     ConcurrentHashMap manager, which has neither eviction nor
		     statistics: an unbounded cache is a memory leak with a nice name,
		     and one whose hit rate cannot be read is a claim rather than a
		     result. See docs/CACHING_STRATEGY.md. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-cache</artifactId>
		</dependency>
		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>2.8.6</version>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  ArchUnit enforces the conventions that this codebase has already been
		  bitten by forgetting: unbounded page sizes, entities on the wire,
		  tenant-unscoped reads. A convention nothing checks is a convention the
		  next contributor cannot know about.
		-->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>1.4.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.opencsv</groupId>
			<artifactId>opencsv</artifactId>
			<version>5.9</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
				Activates the `test` profile, which is what makes
				src/main/resources/application-test.yaml load at all.

				It did not, ever. Nothing set spring.profiles.active for tests, so
				every @SpringBootTest ran on `local` alone and application-test.yaml
				was a file with no effect: the SQL logging it advertises was never on,
				and neither was the small connection pool it declares.

				That second one had teeth. Spring caches a context per distinct test
				configuration, each holding its own Hikari pool, and on `local` that
				is 12 connections each, against the 15 the Supabase pooler allows
				this whole project (docs/CONNECTION_POOL.md). Two live contexts
				exhausted it, and the second failed to start with "Unable to determine
				Dialect without JDBC metadata", which reads like a driver or config
				problem rather than "there were no connections left".

				`local` stays first: it carries the datasource. `test` only overrides.
			-->
			<!--
				THE TWO TIERS.

				`mvn test`   -> Surefire  -> everything except the `integration` group.
				`mvn verify` -> Failsafe  -> the `integration` group as well.

				The split exists because the suite used to make this decision for
				itself. Eighteen classes carried
				`@EnabledIfEnvironmentVariable(named = "DATABASE_URL")`, and with no
				such variable `mvn test` reported "Tests run: 169, Skipped: 64" and
				BUILD SUCCESS in 6.4 seconds. CI ran exactly that on every push. The
				tenant filter, token revocation, idempotency and the query-count
				budget were never executed there and the build was green throughout.

				A test that decides for itself whether to run turns a missing
				dependency into a passing build. So the build decides instead: the
				fast tier always runs in full and is expected to skip nothing, and
				the integration tier fails when it cannot reach a database rather
				than passing empty. `SuiteTieringTest` fails the build if a test
				starts gating itself again.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<spring.profiles.active>local,test</spring.profiles.active>
					</systemPropertyVariables>
					<excludedGroups>integration</excludedGroups>
					<!--
						A fast tier that skips something is a fast tier that is lying
						about its coverage, which is the whole defect this split
						exists to close. Nothing in it is conditional, so anything
						skipped is a mistake and the build should say so.
					-->
					<failIfNoTests>true</failIfNoTests>
				</configuration>
			</plugin>
			<!--
				Failsafe runs the integration tier. Two deliberate settings:

				`<includes>` overrides the default `**/*IT.java`, because these
				classes are named `*Test` and renaming eighteen of them would break
				every reference in the docs and the session log for no gain.

				`<skipAfterFailureCount>` is absent on purpose: a connection failure
				in one class usually means the pooler is exhausted (gotcha 13) and
				the rest will fail too, but which ones fail is the diagnostic.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<spring.profiles.active>local,test</spring.profiles.active>
					</systemPropertyVariables>
					<groups>integration</groups>
					<includes>
						<include>**/*Test.java</include>
						<include>**/*Tests.java</include>
					</includes>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
