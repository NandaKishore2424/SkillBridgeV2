<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.8</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.skillbridge</groupId>
	<artifactId>skillbridge-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>skillbridge-backend</name>
	<description>Backend service for SkillBridge (multi-tenant training management platform)</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>17</java.version>
		<jjwt.version>0.12.6</jjwt.version>
	</properties>
	<dependencies>
		<!--
			JJWT. The version is declared once here and inherited by all three
			artifacts: api is compile-scope, impl and jackson are runtime-only so
			that application code cannot accidentally bind to internals.
		-->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.bucket4j</groupId>
			<artifactId>bucket4j_jdk17-core</artifactId>
			<version>8.17.0</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Scrape target for the Hikari pool gauges. The actuator exposure list
		     names `prometheus`; without this registry that endpoint 404s, so the
		     config would advertise an endpoint that does not exist. -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<!-- Structured logging. JSON off the local profile, so a log aggregator
		     can query fields instead of parsing a line format. -->
		<dependency>
			<groupId>net.logstash.logback</groupId>
			<artifactId>logstash-logback-encoder</artifactId>
			<version>8.0</version>
		</dependency>
		<!-- L1 cache. Caffeine rather than the starter's default simple
		     ConcurrentHashMap manager, which has neither eviction nor
		     statistics: an unbounded cache is a memory leak with a nice name,
		     and one whose hit rate cannot be read is a claim rather than a
		     result. See docs/CACHING_STRATEGY.md. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-cache</artifactId>
		</dependency>
		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>2.8.6</version>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  ArchUnit enforces the conventions that this codebase has already been
		  bitten by forgetting: unbounded page sizes, entities on the wire,
		  tenant-unscoped reads. A convention nothing checks is a convention the
		  next contributor cannot know about.
		-->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>1.4.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			Testcontainers. Spring Boot's parent manages the version, so none is
			declared here.

			This became possible on 2026-09-13 and not before. The integration tier
			needs a PostgreSQL with pgvector, pg_trgm, generated columns and partial
			GIN indexes. H2 has none of them, and a green tick from H2 would prove
			less than no tick at all. Building a matching container needed a schema,
			and after Flyway was removed the schema existed only inside the live
			Supabase project. db/schema/baseline.sql is that schema, and it
			reproduces live's catalogue exactly: 551 objects, digest
			31ef5166e257821574abad4853b7bdad, on live and on a fresh
			pgvector/pgvector:pg17 alike.
		-->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			JSON Schema validation, for the Java half of the AI event contract.

			contracts/ai-events/v1/ai-event.schema.json is the single definition
			of the message the backend publishes and the Python AI service
			consumes. AiEventContractTest validates what the publisher actually
			sends against that file; tests/test_ai_event_contract.py validates the
			consumer against the same file. Neither language can change the wire
			format alone.
		-->
		<dependency>
			<groupId>com.networknt</groupId>
			<artifactId>json-schema-validator</artifactId>
			<version>1.5.4</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.opencsv</groupId>
			<artifactId>opencsv</artifactId>
			<version>5.9</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
				Activates the `test` profile, which is what makes
				src/main/resources/application-test.yaml load at all.

				It did not, ever. Nothing set spring.profiles.active for tests, so
				every @SpringBootTest ran on `local` alone and application-test.yaml
				was a file with no effect: the SQL logging it advertises was never on,
				and neither was the small connection pool it declares.

				That second one had teeth. Spring caches a context per distinct test
				configuration, each holding its own Hikari pool, and on `local` that
				is 12 connections each, against the 15 the Supabase pooler allows
				this whole project (docs/CONNECTION_POOL.md). Two live contexts
				exhausted it, and the second failed to start with "Unable to determine
				Dialect without JDBC metadata", which reads like a driver or config
				problem rather than "there were no connections left".

				`local` stays first: it carries the datasource. `test` only overrides.
			-->
			<!--
				THE TWO TIERS.

				`mvn test`   -> Surefire  -> everything except the `integration` group.
				`mvn verify` -> Failsafe  -> the `integration` group as well.

				The split exists because the suite used to make this decision for
				itself. Eighteen classes carried
				`@EnabledIfEnvironmentVariable(named = "DATABASE_URL")`, and with no
				such variable `mvn test` reported "Tests run: 169, Skipped: 64" and
				BUILD SUCCESS in 6.4 seconds. CI ran exactly that on every push. The
				tenant filter, token revocation, idempotency and the query-count
				budget were never executed there and the build was green throughout.

				A test that decides for itself whether to run turns a missing
				dependency into a passing build. So the build decides instead: the
				fast tier always runs in full and is expected to skip nothing, and
				the integration tier fails when it cannot reach a database rather
				than passing empty. `SuiteTieringTest` fails the build if a test
				starts gating itself again.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<spring.profiles.active>local,test</spring.profiles.active>
					</systemPropertyVariables>
					<excludedGroups>integration</excludedGroups>
					<!--
						A fast tier that skips something is a fast tier that is lying
						about its coverage, which is the whole defect this split
						exists to close. Nothing in it is conditional, so anything
						skipped is a mistake and the build should say so.
					-->
					<failIfNoTests>true</failIfNoTests>
				</configuration>
			</plugin>
			<!--
				Failsafe runs the integration tier. Two deliberate settings:

				`<includes>` overrides the default `**/*IT.java`, because these
				classes are named `*Test` and renaming eighteen of them would break
				every reference in the docs and the session log for no gain.

				`<skipAfterFailureCount>` is absent on purpose: a connection failure
				in one class usually means the pooler is exhausted (gotcha 13) and
				the rest will fail too, but which ones fail is the diagnostic.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<spring.profiles.active>local,test</spring.profiles.active>
					</systemPropertyVariables>
					<groups>integration</groups>
					<includes>
						<include>**/*Test.java</include>
						<include>**/*Tests.java</include>
					</includes>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<!--
				JaCoCo across BOTH tiers.

				Two exec files and a merge, because the tiers run under different
				plugins: Surefire produces jacoco-unit.exec, Failsafe produces
				jacoco-integration.exec. Reporting on only one would understate
				coverage badly. Most of the service and repository code is
				exercised by the integration tier, and a unit-only report would
				make the number look like a reason to delete tests rather than
				write them.
			-->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<!-- Pinned: the Spring Boot parent does not manage this one, and
				     an unpinned plugin version is a build that can change under
				     you without a commit. -->
				<version>0.8.15</version>
				<executions>
					<execution>
						<id>prepare-unit</id>
						<goals><goal>prepare-agent</goal></goals>
						<configuration>
							<destFile>${project.build.directory}/jacoco-unit.exec</destFile>
						</configuration>
					</execution>
					<execution>
						<id>prepare-integration</id>
						<goals><goal>prepare-agent-integration</goal></goals>
						<configuration>
							<destFile>${project.build.directory}/jacoco-integration.exec</destFile>
						</configuration>
					</execution>
					<execution>
						<id>merge</id>
						<phase>post-integration-test</phase>
						<goals><goal>merge</goal></goals>
						<configuration>
							<fileSets>
								<fileSet>
									<directory>${project.build.directory}</directory>
									<includes><include>jacoco-*.exec</include></includes>
								</fileSet>
							</fileSets>
							<destFile>${project.build.directory}/jacoco-merged.exec</destFile>
						</configuration>
					</execution>
					<execution>
						<id>report</id>
						<phase>post-integration-test</phase>
						<goals><goal>report</goal></goals>
						<configuration>
							<dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
							<outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
						</configuration>
					</execution>
					<!--
						A RATCHET, not a target.

						Phase 11 asks for 80% line and 70% branch on service and
						domain packages. The merged suite is at 34.9% line and
						27.4% branch, and these numbers sit just under that, so
						coverage cannot fall without failing the build and every
						batch of tests raises the floor.

						Setting 80% now would mean a red build with no route to
						green except deleting the threshold, and a threshold
						everybody deletes is worse than no threshold.

						Read it honestly. 34.9% is not "the backend is a third
						tested": the covered third is the part that has broken
						before and now has guards on it, and the uncovered part
						is mostly service code nobody has written a test for yet.
						enrollment.service is at 0.6% and bulkupload.service at
						1.4%, and those are the next places worth going.
					-->
					<execution>
						<id>check</id>
						<phase>verify</phase>
						<goals><goal>check</goal></goals>
						<configuration>
							<dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.34</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.27</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
