# --- Secrets -----------------------------------------------------------------
# Anything that can hold a live credential. .env.example is the only committed
# template and must stay value-free.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Spring profile overrides hold real datasource credentials. Only the
# .example templates are tracked.
application-local.yaml
application-local.yml
application-dev.yaml
application-dev.yml
application-prod.yaml
application-prod.yml
!application-*.yaml.example
!application-*.yml.example

# --- Python ------------------------------------------------------------------
venv/
__pycache__/
*.pyc

# --- Datasets ----------------------------------------------------------------
skillbridge-etl-pipeline/data/
*.csv
*.zip

# --- Java build --------------------------------------------------------------
target/
*.jar

# --- Node --------------------------------------------------------------------
node_modules/
dist/

# --- IDE ---------------------------------------------------------------------
.idea/
.vscode/
.cursor/

# --- Agent tooling -----------------------------------------------------------
# Machine-local Claude Code state: per-developer permissions with absolute
# paths, and skill symlinks pointing into .agents/. skills-lock.json is
# committed instead, so the skills can be re-fetched on any machine.
# launch.json is the exception -- it describes how to start this project's dev
# server and is the same for everyone.
.claude/*
!.claude/launch.json
.agents/

# Local helper, not part of the project.
set-db-password.sh

# Plaintext temporary passwords awaiting distribution. Delete once sent.
credentials-to-distribute.txt

# Personal interview study notes, generated from this codebase. Not part of the project.
study-materials/

# Working local logins; never committed (2026-09-19)
further-plans/LOCAL-LOGINS.md

# --- Phase 7 deployment ------------------------------------------------------
# Host-side configuration and anything a backup run leaves behind. app.env
# lives on the EC2 host, not in a checkout, but ignore it here too in case
# somebody copies one back to look at it.
deploy/instance.env
deploy/app.env
deploy/backups/

# Private working notes and AI-assistant configuration. Kept on disk, never published.
further-plans/
AGENTS.md
CLAUDE.md
.claude/
.mcp.json
skills-lock.json
