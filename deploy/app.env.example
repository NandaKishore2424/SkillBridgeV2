# Copy to /opt/skillbridge/app.env on the host, fill in, then:
#
#   sudo chown root:root /opt/skillbridge/app.env
#   sudo chmod 600 /opt/skillbridge/app.env
#
# Every value below is a credential or names the machine. This file is the only
# place they exist; nothing here is baked into an image, which is what makes
# the same image safe to run anywhere.
#
# Generate the secrets ON THE HOST. Do not copy the development machine's: a
# box reachable from the internet should not share a secret with a laptop.

# --- the name the certificate is for ------------------------------------------
#
# The dynamic-DNS hostname from deSEC. skillbridge-dns points it at this
# instance's current public IP at boot, which is why there is no Elastic IP.
# It must match /etc/skillbridge/dns-host.
SITE_ADDRESS=skillbridge.dedyn.io

# Where Let's Encrypt sends expiry warnings. A real address you read.
ACME_EMAIL=you@example.com

# --- Supabase -----------------------------------------------------------------
#
# The SESSION pooler: host aws-N-ap-south-1.pooler.supabase.com, port 5432,
# user postgres.<project-ref>. Not the direct host, and not the pooler on 6543.
#
# Not the direct host, because it is IPv6-only. db.<ref>.supabase.co has no A
# record (checked for this project 2026-09-21: `getent ahostsv4` finds nothing,
# ahostsv6 finds one address), and an EC2 instance in a default VPC has no IPv6
# route. The backend would fail its first connection with "network is
# unreachable" -- after the whole host was built. The laptop does have IPv6,
# which is why the direct host works there and proves nothing about the host.
#
# Not port 6543, because that is TRANSACTION mode: a server connection is lent
# per transaction, so session state and server-side prepared statements do not
# survive -- the PostgreSQL JDBC driver uses those by default, and Flyway's
# advisory lock is session state. Pointing this at 6543 produces migration
# failures that read like database corruption.
#
# Session mode on 5432 gives each client connection one server connection for
# its whole life, which behaves like a direct connection for everything above,
# over IPv4. The price is that pooled connections count against the pooler's
# own ceiling -- see DB_POOL_MAX below.
#
# Supabase Dashboard -> Connect -> Session pooler. Copy the host from there
# rather than typing it: Supabase has more than one pooler cluster per region
# (aws-0-... and aws-1-... both resolve), and only one of them knows the project.
DATABASE_URL=jdbc:postgresql://aws-N-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_USERNAME=postgres.YOUR-PROJECT-REF
DATABASE_PASSWORD=

# The same database in libpq form, for the Python AI service, deploy/backup.sh
# and scripts/db/seed-demo.sh --app-env. Not the same variable name, so both
# services read one file without colliding. Percent-encode any @ : / % in the
# password.
AI_DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-N-ap-south-1.pooler.supabase.com:5432/postgres

# Six, against the session pooler's ceiling of 15 server connections for the
# whole project (measured 2026-09-09 on the old project; docs/CONNECTION_POOL.md).
# Six here and the AI service's fixed two make eight, which leaves room for a
# backup or a seed running at the same time. This project has
# been bitten before by a pool configured larger than the ceiling in front of
# it: Hikari at 30 against a pooler allowing 15 queued for ever while `pending`
# climbed, which reads exactly like "we need a bigger pool". See
# docs/CONNECTION_POOL.md.
DB_POOL_MAX=6
DB_POOL_MIN=2

# --- credentials ---------------------------------------------------------------

# openssl rand -hex 16
RABBITMQ_USER=skillbridge
RABBITMQ_PASSWORD=

# openssl rand -base64 48
#
# At least 32 bytes; JJWT picks the algorithm from the length. Changing it
# invalidates every issued access token, which is the point.
JWT_SECRET=

# openssl rand -hex 32
#
# Guards the AI service's /api/analyze-skills and /metrics. Unset means those
# endpoints answer 503 -- never "open".
AI_SERVICE_TOKEN=

# --- wiring --------------------------------------------------------------------

# RabbitMQ and Mailpit are containers on this host, addressed by service name.
AMQP_URL=amqp://skillbridge:YOUR-RABBITMQ-PASSWORD@rabbitmq:5672/
MAIL_PROVIDER=SMTP
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
MAIL_FROM=SkillBridge <no-reply@skillbridge.invalid>

# The Vercel deployment, used for the link in invitation emails.
#
# CORS_ALLOWED_ORIGINS is deliberately NOT set. The browser never calls this
# host directly -- Vercel rewrites /api/* to it server-side -- so no request
# carries an Origin header and the list is never consulted. Setting it would
# imply a cross-origin path that does not exist. See skillbridge-frontend/VERCEL.md.
MAIL_LOGIN_URL=https://YOUR-APP.vercel.app/first-login

# TLS terminates at Caddy and the cookie is first-party through the Vercel
# rewrite, so it must be Secure. This is the default; written out because
# getting it wrong is silent.
REFRESH_COOKIE_SECURE=true

# A complete map of the attack surface. Off.
SWAGGER_ENABLED=false
