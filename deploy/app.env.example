# Copy to /opt/skillbridge/app.env on the host, fill in, then:
#
#   sudo chown root:root /opt/skillbridge/app.env
#   sudo chmod 600 /opt/skillbridge/app.env
#
# Every value below is a credential or names the machine. This file is the only
# place they exist; nothing here is baked into an image, which is what makes
# the same image safe to run anywhere.
#
# Generate the secrets ON THE HOST. Do not copy the development machine's: a
# box reachable from the internet should not share a secret with a laptop.

# --- the name the certificate is for ------------------------------------------
#
# The dynamic-DNS hostname from deSEC. skillbridge-dns points it at this
# instance's current public IP at boot, which is why there is no Elastic IP.
# It must match /etc/skillbridge/dns-host.
SITE_ADDRESS=skillbridge.dedyn.io

# Where Let's Encrypt sends expiry warnings. A real address you read.
ACME_EMAIL=you@example.com

# --- Supabase -----------------------------------------------------------------
#
# The DIRECT connection (port 5432), not the transaction pooler on 6543.
#
# The pooler is the right choice for serverless functions opening a connection
# per request. This is one long-lived JVM with a Hikari pool of six, so it gains
# nothing from it -- and loses something: transaction-mode pooling does not
# support session state or server-side prepared statements, which the
# PostgreSQL JDBC driver uses by default and Flyway's advisory locks rely on.
# Pointing this at 6543 produces migration failures that read like database
# corruption.
#
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> JDBC.
DATABASE_URL=jdbc:postgresql://db.YOUR-PROJECT.supabase.co:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# The same database in libpq form, for the Python AI service. Not the same
# variable name, so both services read one file without colliding.
AI_DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# Six, against Supabase's own connection ceiling. The free tier allows far
# fewer direct connections than a self-hosted PostgreSQL, and this project has
# been bitten before by a pool configured larger than the ceiling in front of
# it: Hikari at 30 against a pooler allowing 15 queued for ever while `pending`
# climbed, which reads exactly like "we need a bigger pool". See
# docs/CONNECTION_POOL.md.
DB_POOL_MAX=6
DB_POOL_MIN=2

# --- credentials ---------------------------------------------------------------

# openssl rand -hex 16
RABBITMQ_USER=skillbridge
RABBITMQ_PASSWORD=

# openssl rand -base64 48
#
# At least 32 bytes; JJWT picks the algorithm from the length. Changing it
# invalidates every issued access token, which is the point.
JWT_SECRET=

# openssl rand -hex 32
#
# Guards the AI service's /api/analyze-skills and /metrics. Unset means those
# endpoints answer 503 -- never "open".
AI_SERVICE_TOKEN=

# --- wiring --------------------------------------------------------------------

# RabbitMQ and Mailpit are containers on this host, addressed by service name.
AMQP_URL=amqp://skillbridge:YOUR-RABBITMQ-PASSWORD@rabbitmq:5672/
MAIL_PROVIDER=SMTP
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
MAIL_FROM=SkillBridge <no-reply@skillbridge.invalid>

# The Vercel deployment, used for the link in invitation emails.
#
# CORS_ALLOWED_ORIGINS is deliberately NOT set. The browser never calls this
# host directly -- Vercel rewrites /api/* to it server-side -- so no request
# carries an Origin header and the list is never consulted. Setting it would
# imply a cross-origin path that does not exist. See skillbridge-frontend/VERCEL.md.
MAIL_LOGIN_URL=https://YOUR-APP.vercel.app/first-login

# TLS terminates at Caddy and the cookie is first-party through the Vercel
# rewrite, so it must be Secure. This is the default; written out because
# getting it wrong is silent.
REFRESH_COOKIE_SECURE=true

# A complete map of the attack surface. Off.
SWAGGER_ENABLED=false
