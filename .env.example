# ============================================================================
# SkillBridge — environment template
# ============================================================================
# Copy to `.env` and fill in real values. `.env` is gitignored; this file must
# never contain a working credential.
#
#   cp .env.example .env
#
# Backend reads these via Spring's ${VAR} placeholders (application.yaml).
# AI service reads them via python-dotenv (skillbridge-ai-service/config.py).
# ============================================================================

# --- Database (Supabase / PostgreSQL) ---------------------------------------
DATABASE_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# Same database, libpq URL form — used by the Python AI service.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@YOUR_SUPABASE_HOST:5432/postgres

# --- Message broker (CloudAMQP) ---------------------------------------------
AMQP_URL=amqps://user:password@host/vhost

# --- Auth --------------------------------------------------------------------
# HS256 signing key. Must be at least 32 bytes; generate a fresh one with:
#   openssl rand -base64 48
# Rotating this invalidates every issued access token, which is the point.
JWT_SECRET=
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=1209600

# --- Runtime -----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
RATE_LIMIT_RPM=120
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
