# ============================================================================
# SkillBridge — environment template
# ============================================================================
# Copy to `.env` and fill in real values. `.env` is gitignored; this file must
# never contain a working credential.
#
#   cp .env.example .env
#
# AI service: reads this file directly via python-dotenv (config.py). Works as-is.
#
# Backend: Spring Boot does NOT read .env files. application.yaml resolves
# ${VAR} against real environment variables and the JVM's properties, so a .env
# sitting here reaches Java only if something exports it first. Pick one:
#
#   1. application-local.yaml (this repo's existing pattern, gitignored) —
#      copy application-local.yaml.example and put the values there instead.
#   2. Export them into the shell before running:
#        set -a; . ./.env; set +a; cd skillbridge-backend && ./mvnw spring-boot:run
#   3. Add the me.paulschwarz:spring-dotenv dependency, which teaches Spring to
#      read .env. Not currently in pom.xml.
#
# Option 1 is the least surprising; see further-plans/HANDOVER.md § Next Action.
# ============================================================================

# --- Database (local Docker PostgreSQL, docker-compose.yml) -----------------
# Generate once: openssl rand -hex 24. docker compose reads it from this file.
SKILLBRIDGE_DB_PASSWORD=

# Backend (jdbc form).
DATABASE_URL=jdbc:postgresql://localhost:5433/skillbridge
DATABASE_USERNAME=skillbridge
DATABASE_PASSWORD=

# Same database, libpq form, for the Python AI service and the ETL.
#
# Prefer the limited role: scripts/db/ai-service-role.sql creates skillbridge_ai,
# which can read a student's skills and the job corpus and write the dedup and
# report tables, and cannot read users, refresh_tokens or the audit trail. The
# application's own account still works, and grants far more than this service
# needs.
AI_DATABASE_URL=postgresql://skillbridge_ai:PASSWORD@localhost:5433/skillbridge

# --- Message broker (CloudAMQP) ---------------------------------------------
AMQP_URL=amqps://user:password@host/vhost

# --- Auth --------------------------------------------------------------------
# HMAC signing key. At least 32 bytes; JJWT picks the algorithm from the
# length (48 bytes, as generated below, signs HS384). Generate a fresh one with:
#   openssl rand -base64 48
# Rotating this invalidates every issued access token, which is the point.
JWT_SECRET=
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=1209600

# How long an invitation's emailed temporary password works.
INVITATION_TTL=7d

# --- AI service ----------------------------------------------------------------
# Guards the AI service's HTTP endpoints (/api/analyze-skills, /metrics). The
# probes stay open. Unset means those endpoints answer 503, never "open":
#   openssl rand -hex 32
AI_API_TOKEN=

# --- Mail ----------------------------------------------------------------------
# LOG sends nothing (recipient and subject only are logged). SMTP with the
# Mailpit from docker-compose catches every message at http://localhost:8026.
# RESEND needs an API key and a domain verified with Resend.
MAIL_PROVIDER=SMTP
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
MAIL_FROM=SkillBridge <no-reply@skillbridge.local>
MAIL_LOGIN_URL=http://localhost:5173/first-login
RESEND_API_KEY=

# --- Runtime -----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
